  "definitions": [
    {
      "text": "lukke med segl",
      "translation": "to close with a seal",
      "examples": [
        {
          "no": "brevet var forseglet",
          "en": "the letter was sealed"
        }
      ]
    },
    {
      "text": "validere med segl",
      "translation": "to validate with a seal",
      "examples": [
        {
          "no": "forsegle et dokument",
          "en": "seal a document"
        }
      ]
    },
    {
      "text": "dekke slik at innholdet ikke kommer ut",
      "translation": "to cover so that the contents cannot escape",
      "examples": [
        {
          "no": "forsegle en melkekartong",
          "en": "seal a milk carton"
        },
        {
          "no": "forsegle en krukke",
          "en": "seal a jar"
        }
      ]
    },
    {
      "text": "stenge for adgang",
      "translation": "to close off access",
      "examples": []
    },
    {
      "text": "plombere, låse",
      "translation": "to seal, to lock",
      "examples": [
        {
          "no": "politiet forseglet døra til huset",
          "en": "the police sealed the door of the house"
        }
      ]
    },
    {
      "text": "i overført betydning: fullbyrde, validere gjennom en gest",
      "translation": "in a figurative sense: to complete, to validate through a gesture",
      "examples": [
        {
          "no": "forsegle en avtale med et håndtrykk",
          "en": "seal an agreement with a handshake"
        },
        {
          "no": "forsegle sin kjærlighet med et kyss",
          "en": "seal one's love with a kiss"
        }
      ]
    }
