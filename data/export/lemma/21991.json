  "definitions": [
    {
      "text": "smykke til å ha rundt halsen",
      "translation": "jewelry to wear around the neck",
      "examples": [
        {
          "no": "hun hadde et nydelig halsbånd med diamanter",
          "en": "she was wearing a lovely diamond necklace"
        }
      ]
    },
    {
      "text": "reim, lenke eller ring til å ha rundt halsen på dyr",
      "translation": "strap, chain, or ring to wear around an animal's neck",
      "examples": [
        {
          "no": "ta på hunden halsbåndet før en går på tur",
          "en": "put the collar on the dog before going for a walk"
        }
      ]
    }
  ]
