      "examples": []
    },
    {
      "text": "i overført betydning: mengde av mennesker, dyr eller kjøretøy som stormer fram eller bråker",
      "translation": "a multitude of people, animals, or vehicles storming forward or making noise",
      "examples": [
        {
          "no": "det kom en hel åsgårdsrei av pressefolk",
          "en": "there came a whole wild horde of press people"
        }
      ]
    },
