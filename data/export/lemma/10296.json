  "definitions": [
    {
      "text": "utestenge fra (plassering i) idrettskonkurranse på grunn av regelbrudd",
      "translation": "to disqualify from (a placement in) a sports competition due to a rule violation",
      "examples": [
        {
          "no": "A-laget ble diskvalifisert i stafetten",
          "en": "the A team was disqualified in the relay"
        }
      ]
    },
    {
      "text": "gjøre uskikket",
      "translation": "to make unfit or unsuitable",
      "examples": [
        {
          "no": "med en slik uttalelse diskvalifiserer han seg selv",
          "en": "with a statement like that, he disqualifies himself"
        },
        {
          "no": "fortiden hennes diskvalifiserer henne for dette oppdraget",
          "en": "her past disqualifies her for this assignment"
        }
      ]
    }
